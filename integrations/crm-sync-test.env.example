# Non-secret target settings for a separate test spreadsheet only.
# The TEST prefix is mandatory. Do not point this at the production CRM.
CRM_SYNC_ENV=test
CRM_SYNC_TEST_SHEET_ID=replace_with_dedicated_test_spreadsheet_id
CRM_SYNC_TEST_TAB=TEST CRM
CRM_SYNC_WRITE=false
# Provider credentials belong only in a private runner's secret store.
# The GitHub workflow does not require or reference them.
